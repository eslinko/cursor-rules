### Automation Hooks

```javascript
// Example: Auto-track pipeline metrics
function trackPipelineSession(sessionData) {
  return {
    session_id: sessionData.timestamp,
    intent_hash: hash(sessionData.intent_vector),
    phases_completed: sessionData.metrics.phases.length,
    total_time_s: sum(sessionData.metrics.phases.map(p => p.elapsed_time_s)),
    test_success_rate: sessionData.metrics.tests_passed / sessionData.metrics.tests_run,
    files_modified: unique(sessionData.metrics.files_touched).length,
    checkpoints_passed: sessionData.checkpoints.filter(c => c.approved).length
  };
}

// Example: Generate Intent Vector from project context
function inferIntentVector(context) {
  const recentEdits = analyzeRecentEdits(context.files);
  const userMessages = parseUserMessages(context.chat);
  const existingDocs = scanDocumentation(context.docs);
  
  return {
    problem: extractProblemStatement(userMessages, existingDocs),
    outcome: inferDesiredOutcome(recentEdits, userMessages),
    scope: detectScope(recentEdits, existingDocs),
    constraints: extractConstraints(existingDocs, userMessages),
    acceptance_criteria: inferAC(userMessages, existingDocs),
    risks: identifyRisks(context),
    priority: inferPriority(userMessages),
    timebox: extractTimebox(userMessages),
    stakeholders: identifyStakeholders(context)
  };
}
```

