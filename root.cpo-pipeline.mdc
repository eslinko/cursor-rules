━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
3 lines of "done means...":
- AC#1 (positive test)
- AC#2 (positive test)
- AC#3 (negative test: what should fail)

Example:
- "Searching 'laptop' returns relevant products in <200ms"
- "Empty search shows helpful message, not error"
- "SQL injection attempts are blocked and logged"

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
